# 이 파일을 복사해서 .env 로 이름을 바꾸고, 실제 키를 채우세요.
#   Windows:  copy .env.example .env
#   Mac:      cp .env.example .env
#
# .env 는 .gitignore 에 등록돼 있어 깃에 올라가지 않습니다.
#
# ⚠️ 이 파일(.env.example)은 깃에 올라갑니다. 여기에는 절대 실제 키를 적지 마세요.
#    실제 키는 .env 에만 둡니다. 둘을 헷갈리면 키가 그대로 공개됩니다.

OPENAI_API_KEY=sk-proj-REPLACE_ME

# 모델은 여기서만 바꿉니다. 코드 안에 모델명을 흩뿌리지 않기 위한 규칙입니다.
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
